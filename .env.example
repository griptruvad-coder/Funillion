# Copy these into Railway → your service → Variables. NEVER commit real keys to git.

# --- Real events (Google Events via SerpApi) ---
SERPAPI_KEY=                     # from serpapi.com → Dashboard → Your Private API Key
SERPAPI_MONTHLY_LIMIT=240        # free plan = 250 searches/month; raise on a paid plan
SERPAPI_REFRESH_DAYS=7           # one refresh = 14 cities x 4 searches = 56 searches
# SERPAPI_QUERIES=Events in {city}|Concerts in {city}|Comedy shows in {city}|Workshops in {city}
# SERPAPI_CITIES=delhi,mumbai,bengaluru   # limit cities to save searches
CONTACT_EMAIL=                   # sent to OpenStreetMap's geocoder (their usage policy asks for contact info)

# --- Demo data ---
# SEED_DEMO=off                  # default: off on Railway, on locally. 'off' removes fake events + demo people

# --- Admin (can press "Pull real events now") ---
ADMIN_EMAILS=                    # comma-separated emails of Funillion accounts that are admins

# --- Razorpay (use TEST keys until real organisers list real events) ---
RAZORPAY_KEY_ID=                 # rzp_test_... (Dashboard → Test Mode → Account & Settings → API Keys)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=         # the secret you type when creating the webhook

# --- Frontend on Netlify ---
ALLOWED_ORIGINS=                 # https://your-site.netlify.app,https://funillion.com,https://www.funillion.com

# --- Optional ---
# AFFILIATE_TEMPLATES={"bookmyshow.com":"https://your-affiliate-network/redirect?url={url}"}
# BRAND_NAME=Funillion
# ANTHROPIC_API_KEY=             # better Hinglish understanding in Plan My Day
